<ui:FluentWindow x:Class="CompilePalX.ParameterAdder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Add Parameter" Height="480" Width="918"
        Icon="..\CompilePalIcon.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="Window_OnPreviewKeyDown" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- A FluentWindow draws no caption buttons of its own; without this the dialog cannot be
             closed or dragged at all. -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="..\CompilePalIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TextBox Grid.Row="0" Name="SearchBox" Margin="10,10,10,0" TextChanged="SearchBox_OnTextChanged"
                    PlaceholderText="Search parameters by name, flag or description"
                    AutomationProperties.Name="Search parameters"/>

        <DataGrid Grid.Row="1" Name="ConfigDataGrid" Margin="10,10,10,0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" ItemsSource="{Binding}" MouseDoubleClick="ConfigDataGrid_MouseUp" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{ Binding Name}" IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Param" Binding="{ Binding Parameter}" IsReadOnly="True" Width="Auto"/>
                <DataGridTextColumn Header="Description" Binding="{ Binding Description}" IsReadOnly="True" Width="2*" MinWidth="200" ElementStyle="{StaticResource CompilePal.Styles.WrappingCellText}"/>
                <DataGridTextColumn Header="Issues" Binding="{ Binding Warning}" IsReadOnly="True" Width="1*" MinWidth="120" ElementStyle="{StaticResource CompilePal.Styles.WrappingCellText}"/>
            </DataGrid.Columns>
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Grid>
                                            <Expander IsExpanded="False" x:Name="GroupExpander">
                                                <Expander.Header>
                                                    <DockPanel ToolTip="Parameter may be incompatible with the current game">
                                                        <iconPacks:PackIconMaterial Kind="Alert" Foreground="{DynamicResource CompilePal.Brushes.Warning}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="14" Margin="5, 2, 5, 0" Visibility="Visible"/>
                                                    </DockPanel>
                                                </Expander.Header>
                                                <Expander.Content>
                                                    <ItemsPresenter/>
                                                </Expander.Content>
                                                <Expander.Style>
                                                    <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                                    </Style>
                                                </Expander.Style>
                                            </Expander>
                                            <ItemsPresenter x:Name="Presenter" Visibility="Collapsed"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="IsCompatible">
                                                <Setter TargetName="GroupExpander" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="Presenter" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="PresetHeaderBlock" FontWeight="Bold" FontSize="14" Margin="5, 2, 5, 0" Visibility="Visible"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>

        <!-- The dialog used to commit only on double-click, with no buttons and no Enter handling, so
             there was nothing on screen saying how to add anything. -->
        <DockPanel Grid.Row="2" Margin="10">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Double-click a parameter, or select it and press Enter."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="88" Click="CancelButton_OnClick" IsCancel="True"/>
                <ui:Button Name="AddButton" Appearance="Primary" Content="Add" Width="88" Margin="8,0,0,0" Click="AddButton_OnClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
    </Grid>
</ui:FluentWindow>
