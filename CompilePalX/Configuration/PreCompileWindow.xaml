<ui:FluentWindow x:Class="CompilePalX.Configuration.PreCompileWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:config="clr-namespace:CompilePalX.Configuration"
                 Title="Before compiling"
                 Height="440" Width="620"
                 MinHeight="320" MinWidth="480"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI">

  <ui:FluentWindow.Resources>
    <config:StatusSeverityBrushConverter x:Key="SeverityBrush"/>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                 ShowMaximize="False" ShowMinimize="False"/>

    <StackPanel Grid.Row="1" Margin="18,8,18,0">
      <TextBlock x:Name="HeadlineText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="SubText" Margin="0,4,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="2" Margin="18,12,18,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="StatusList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="6" Padding="12,9" Margin="0,0,0,6"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderThickness="0,0,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="4"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Stretch"
                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>

                <StackPanel Grid.Column="1">
                  <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                    <Run Text="{Binding MapName, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding Label, Mode=OneWay}"/>
                  </TextBlock>
                  <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                  <TextBlock Text="{Binding StepName}" FontSize="10.5" Margin="0,3,0,0"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <DockPanel Grid.Row="3" Margin="18,14,18,16">
      <ui:Button x:Name="ProceedButton" DockPanel.Dock="Right" Appearance="Primary"
                 Content="Compile" Click="ProceedButton_Click" MinWidth="110"/>
      <ui:Button DockPanel.Dock="Right" Margin="0,0,8,0" Content="Cancel"
                 Click="CancelButton_Click" IsCancel="True" MinWidth="90"/>
      <TextBlock x:Name="FootnoteText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11.5"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
    </DockPanel>
  </Grid>
</ui:FluentWindow>
