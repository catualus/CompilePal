<ui:FluentWindow x:Class="CompilePalX.Compiling.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Compile Pal X - Interlopers Error" Icon="../CompilePalIcon.ico"
                      Height="500" Width="800"
                      MinHeight="500" MinWidth="800"
                      MaxHeight="500" MaxWidth="800"
                      FontFamily="Segoe UI Variable Text, Segoe UI" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- A FluentWindow draws no caption buttons of its own; without this the dialog
             cannot be closed or dragged at all. -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="../CompilePalIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    <Grid Grid.Row="1">
        <WebBrowser Name="ErrorBrowser" Margin="0"/>

    </Grid>
    </Grid>
</ui:FluentWindow>
