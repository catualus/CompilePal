<ui:FluentWindow x:Class="CompilePalX.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:CompilePalX"
        mc:Ignorable="d"
        Title="Settings"
          Height="450" Width="800"
          MinHeight="450" MinWidth="800"
          Icon="CompilePalIcon.ico"
          FontFamily="Segoe UI Variable Text, Segoe UI" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- A FluentWindow draws no caption buttons of its own; without this the dialog
             cannot be closed or dragged at all. -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="CompilePalIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" FocusManager.FocusedElement="{Binding ElementName=ErrorSourceURL}">
                <StackPanel Margin="0, 0, 0, 10" HorizontalAlignment="Left">
                    <Label Padding="0, 5 5, 5" Margin="0, 0, -5, 0" IsTabStop="False">Appearance</Label>
                    <ComboBox ItemsSource="{Binding Path=Themes, Mode=OneTime}" SelectedItem="{Binding Path=Theme, Mode=TwoWay}" MinWidth="200" HorizontalAlignment="Left"
                              ToolTip="System follows the Windows light/dark setting. Applied as soon as you save."/>
                </StackPanel>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=ErrorSourceURL, Mode=TwoWay}" Tag="Error Source" Name="ErrorSourceURL"/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=ErrorCacheExpirationDays , Mode=TwoWay}" Tag="Error Cache Duration" Name="ErrorCacheDurationDays" ToolTip="How many days to cache error information" PreviewTextInput="ErrorCacheDurationDays_PreviewTextInput"/>
                <StackPanel Margin="0, 0, 0, 5" HorizontalAlignment="Left">
                    <Label Padding="0, 5 5, 5" Margin="0, 0, -5, 0" IsTabStop="False">Play Sound On Compile Completion</Label>
                    <CheckBox IsChecked="{Binding Path=PlaySoundOnCompileCompletion, Mode=TwoWay}" Focusable="True" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Margin="0, 5, 0, 5" HorizontalAlignment="Left">
                    <Label Padding="0, 5 5, 5" Margin="0, 0, -5, 0" IsTabStop="False">Hammer++ Compile Tools (tools++)</Label>
                    <ComboBox ItemsSource="{Binding Path=ToolsPlusPlusModes, Mode=OneTime}" SelectedItem="{Binding Path=ToolsPlusPlusMode, Mode=TwoWay}" MinWidth="200" HorizontalAlignment="Left"
                              ToolTip="Auto inspects the configured vbsp/vvis/vrad/bspzip binaries and shows tools++ only parameters when ficool2's tools are detected.&#x0a;Restart Compile Pal after changing this."/>
                </StackPanel>
                <StackPanel Margin="0, 5, 0, 5" HorizontalAlignment="Left" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding Path=PreferToolsPlusPlusBinaries, Mode=TwoWay}" Focusable="True" VerticalAlignment="Center"
                              ToolTip="When a tools++ build of vbsp/vvis/vrad/bspzip is found next to the configured binary (usually in bin/win64 or bin/x64), run it instead - even though the Game Configuration screen still shows the path you typed there.&#x0a;Turn this off to always run exactly the binary configured in Game Configuration."/>
                    <TextBlock Text="Prefer tools++ binaries when found, even if not the one configured" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <!-- UpdateSourceTrigger=PropertyChanged on purpose. The default for TextBox.Text is
                     LostFocus, so a value typed and then committed with the Save button (or Enter)
                     without the box losing focus first never reaches the Settings object, and the
                     save silently writes the old value back. -->
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=OutputFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Output Font" Name="OutputFontFamily"
                          ToolTip="Font used for the OUTPUT tab. Comma-separated fallback list, same as a XAML FontFamily. Keep this monospace or compiler tables (VBSP's lump report, etc.) will misalign.&#x0a;Applies as soon as you save."/>
                <TextBox Template="{StaticResource LabeledTextbox}" Text="{Binding Path=OutputFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="Output Font Size" Name="OutputFontSize"
                          PreviewTextInput="OutputFontSize_PreviewTextInput" ToolTip="Font size for the OUTPUT tab. Applies as soon as you save."/>
            </StackPanel>
        </ScrollViewer>
        <ui:Button Grid.Row="1" Appearance="Primary" Click="SaveButton_Click">Save</ui:Button>
    </Grid>
    </Grid>
</ui:FluentWindow>
