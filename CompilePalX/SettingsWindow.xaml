<ui:FluentWindow x:Class="CompilePalX.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:CompilePalX"
        mc:Ignorable="d"
        Title="Settings"
          Height="600" Width="720"
          MinHeight="420" MinWidth="560"
          Icon="CompilePalIcon.ico"
          FontFamily="Segoe UI Variable Text, Segoe UI" >
    <Window.Resources>
        <!-- One row per setting: label and explanation on the left, the control on the right. The window
             used to be eight unrelated controls stacked in a single scroller, so an error-database URL
             sat directly above "play a sound when the compile finishes" with nothing to separate them. -->
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,16,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- A FluentWindow draws no caption buttons of its own; without this the dialog
             cannot be closed or dragged at all. -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="CompilePalIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    <Grid Grid.Row="1" Margin="20,4,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel Orientation="Vertical">

                <TextBlock Style="{StaticResource SectionHeading}" Text="APPEARANCE" Margin="2,4,0,6"/>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                                  ItemsSource="{Binding Path=Themes, Mode=OneTime}" SelectedItem="{Binding Path=Theme, Mode=TwoWay}"
                                  AutomationProperties.Name="Theme"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Theme"/>
                            <TextBlock Style="{StaticResource SettingHint}" Text="System follows the Windows light/dark setting. Applied as soon as you save."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeading}" Text="COMPILE OUTPUT"/>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <!-- A picker over the monospace families actually installed, rather than a text
                             box asking for "a comma-separated fallback list, same syntax as a XAML
                             FontFamily" - which was a config file rendered as a form. -->
                        <ComboBox DockPanel.Dock="Right" MinWidth="220" VerticalAlignment="Center" Name="OutputFontFamily"
                                  IsEditable="True"
                                  ItemsSource="{Binding Path=MonospaceFonts, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneTime}"
                                  Text="{Binding Path=OutputFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="Output font">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Font"/>
                            <TextBlock Style="{StaticResource SettingHint}" Text="Monospace families installed on this machine. Compiler output is aligned with spaces, so a proportional font will misalign it. Applies as soon as you save."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ui:NumberBox DockPanel.Dock="Right" MinWidth="120" VerticalAlignment="Center" Name="OutputFontSize"
                                      Minimum="6" Maximum="72" SmallChange="1"
                                      Value="{Binding Path=OutputFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="Output font size"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Font size"/>
                            <TextBlock Style="{StaticResource SettingHint}" Text="Applies as soon as you save."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Padding="10,6" CornerRadius="4" MinWidth="220"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <TextBlock Name="FontPreview" Text="VBSP  1024  [====]  0.00%"
                                       FontFamily="{Binding Text, ElementName=OutputFontFamily}"
                                       FontSize="{Binding Value, ElementName=OutputFontSize}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Preview"/>
                            <TextBlock Style="{StaticResource SettingHint}" Text="How the OUTPUT tab will render."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeading}" Text="COMPILE TOOLS"/>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                                  ItemsSource="{Binding Path=ToolsPlusPlusModes, Mode=OneTime}" SelectedItem="{Binding Path=ToolsPlusPlusMode, Mode=TwoWay}"
                                  AutomationProperties.Name="Hammer++ compile tools mode"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Hammer++ tools (tools++)"/>
                            <TextBlock Style="{StaticResource SettingHint}" Text="Auto inspects the configured vbsp/vvis/vrad/bspzip binaries and shows tools++ only parameters when ficool2's tools are detected. Restart Compile Pal after changing this."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                         IsChecked="{Binding Path=PreferToolsPlusPlusBinaries, Mode=TwoWay}"
                                         AutomationProperties.Name="Prefer tools++ binaries when found"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Prefer tools++ binaries when found"/>
                            <TextBlock Style="{StaticResource SettingHint}" Text="Run a tools++ build of vbsp/vvis/vrad/bspzip found next to the configured binary, even though Game Configuration still shows the path you typed. Turn this off to always run exactly what is configured."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeading}" Text="ERROR CHECKING"/>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Right" MinWidth="260" VerticalAlignment="Center" Name="ErrorSourceURL"
                                 Text="{Binding Path=ErrorSourceURL, Mode=TwoWay}"
                                 AutomationProperties.Name="Error database URL"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Error database"/>
                            <TextBlock Style="{StaticResource SettingHint}" Text="Where compile error explanations are fetched from. Compile Pal falls back to its bundled catalogue when this is unreachable."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ui:NumberBox DockPanel.Dock="Right" MinWidth="120" VerticalAlignment="Center" Name="ErrorCacheDurationDays"
                                      Minimum="0" Maximum="365" SmallChange="1"
                                      Value="{Binding Path=ErrorCacheExpirationDays, Mode=TwoWay}"
                                      AutomationProperties.Name="Error cache duration in days"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Cache duration"/>
                            <TextBlock Style="{StaticResource SettingHint}" Text="Days to keep downloaded error information before fetching it again."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionHeading}" Text="NOTIFICATIONS"/>

                <Border Style="{StaticResource SettingRow}">
                    <DockPanel>
                        <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                         IsChecked="{Binding Path=PlaySoundOnCompileCompletion, Mode=TwoWay}"
                                         AutomationProperties.Name="Play a sound when a compile finishes"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Sound on completion"/>
                            <TextBlock Style="{StaticResource SettingHint}" Text="Plays the system notification sound when a compile finishes."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="96" Height="32" IsCancel="True" Click="CancelButton_Click"/>
            <ui:Button Appearance="Primary" Content="Save" Width="96" Height="32" Margin="8,0,0,0" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
</ui:FluentWindow>
