<ui:FluentWindow x:Class="CompilePalX.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Game Selector" Height="444" Width="640" Icon="..\CompilePalIcon.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- A FluentWindow draws no caption buttons of its own; without this the window cannot be
             closed or dragged at all. This one is the first thing shown at startup, so it also keeps
             minimise. -->
        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" ShowMaximize="False" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="..\CompilePalIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    <Grid Grid.Row="1">
        <StackPanel Margin="10, 0, 10, 40" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="EmptyState">
            <Grid HorizontalAlignment="Center" Margin="0, -40, 0, 20">
                <iconPacks:Material Kind="HelpRhombus" Height="40" Width="40"/>
            </Grid>
            <TextBlock HorizontalAlignment="Center" FontWeight="Bold" FontSize="14">No Game Configurations Found</TextBlock>
            <!-- Compile Pal now scans the Steam libraries itself, so "launch Hammer first" is no longer
                 the instruction - a game with no Hammer configuration on disk genuinely has nothing to
                 read, which is a different problem and needs a different suggestion. -->
            <TextBlock HorizontalAlignment="Center" Margin="0, 5, 0, 4" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420">
                Compile Pal looks for Source games in your Steam libraries. If one is missing, open Hammer for it once so it writes its configuration, then
                <Hyperlink Foreground="{DynamicResource CompilePal.Brushes.Link}" Click="RefreshButton_OnClick">scan again</Hyperlink>.
            </TextBlock>
            <TextBlock HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0, 6, 0, 0">Or</TextBlock>
            <Button Margin="0, 10, 0, 0" Click="AddButton_OnClick">Add Game Manually</Button>
        </StackPanel>
        <Grid x:Name="FilledState">
            <Grid Margin="10, 10, 10, 40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="GameGrid" Margin="0,0,5,0" HorizontalContentAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding}" MouseDoubleClick="Button_Click" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{ Binding Name}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Path" Binding="{ Binding GameFolder}" IsReadOnly="True" Width="*"/>
                        <!-- Editing a game's paths is the reason most people open this window, and it used
                             to be reached through a 5px-tall borderless kebab with an 8px glyph and
                             negative margins - a control you had to already know was there. A labelled
                             button says what the row can do; the menu behind it keeps Delete from sitting
                             one mis-click away from the row you are about to launch. -->
                        <DataGridTemplateColumn Width="auto" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Name="GameManageButton" Margin="4,3,6,3" Padding="10,3" VerticalAlignment="Center"
                                            ToolTip="Edit or delete this game configuration"
                                            AutomationProperties.Name="Manage game configuration"
                                            ContextMenuOpening="GameManageButton_OnContextMenuOpening" Click="GameManageButton_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Manage" FontSize="12" VerticalAlignment="Center"/>
                                            <iconPacks:PackIconMaterial Kind="ChevronDown" Height="9" Width="9" Margin="7,1,0,0" VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        <Button.ContextMenu>
                                            <ContextMenu Name="GameActionMenu" Placement="Bottom">
                                                <MenuItem Header="Edit..." Click="EditButton_OnClick" />
                                                <Separator/>
                                                <MenuItem Header="Delete" Click="DeleteButton_OnClick"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0, -1, 0, 0" HorizontalAlignment="Right">
                    <Button Name="RefreshButton" Margin="0, 0, 5, 0" Height="20" Width="25" Padding="-4" VerticalAlignment="Top" Click="RefreshButton_OnClick" ToolTip="Refresh Game Configurations" AutomationProperties.Name="Refresh Game Configurations"><iconPacks:Material Kind="Refresh" Height="13" Width="13"/></Button>
                    <Button Name="AddButton" Height="20" Width="25" Padding="-4" VerticalAlignment="Top" Click="AddButton_OnClick" ToolTip="Add Game Configuration" AutomationProperties.Name="Add Game Configuration"><iconPacks:Material Kind="Plus" Height="13" Width="13"/></Button>
                </StackPanel>
            </Grid>
            <ui:Button Name="LaunchButton" Appearance="Primary" Content="Launch" Margin="0,0,10,10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="75" Click="Button_Click" IsEnabled="{Binding ElementName=GameGrid, Path=SelectedItems.Count}"/>
        </Grid>
    </Grid>
    </Grid>
</ui:FluentWindow>
