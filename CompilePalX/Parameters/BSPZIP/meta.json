{
  "Name": "BSPZIP",
  "Path": "$bspZip$",
  "Order": 12.1,
  "DoRun": true,
  "ReadOutput": true,
  "Description": "Command line tool for modifying BSP files.",
  "Warning": "",
  "PresetDefault": false,
  "Arguments": " -game $game$ ",
  "BasisString": " $mapCopyLocation$",
  "CheckExitCode": false,
  "SupportsBSP": true,
  // The old gmod (4000) exclusion assumed the distribution had no usable bspzip.exe. Current Garry's Mod
  // ships bspzip in both bin/ and bin/win64/, and bspzip++ can be installed for branches that do not.
  // Compile Pal reports a clear error if the binary is genuinely missing.
  "WorkingDirectory": "$binFolder$"
}