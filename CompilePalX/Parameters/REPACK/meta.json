{
  "Name": "REPACK",
  "Path": "$bspZip$",
  "Order": 12.0,
  "DoRun": false,
  "ReadOutput": true,
  "Description": "BSPzip.exe's BSP Compression.",
  "Warning": "",
  "PresetDefault": false,
  // -compress is a bspzip++ feature. Stock bspzip (Garry's Mod's included) exits 1 with no output
  // when it is passed, which CheckExitCode below turns into a clear failure rather than a silent
  // no-op. It also compresses the entity lump, which is why ENTLUMP is ordered before this step.
  "Arguments": " -game $game$ -repack",
  "BasisString": " $mapCopyLocation$",
  "SupportsBSP": true,
  // No CompatibleGames gate: the old TF2/CS:S/Momentum whitelist dated from when Garry's Mod shipped a
  // pre-2015 bspzip without -repack. Current GMod bspzip (both bin/ and bin/win64/) documents
  // "-repack [ -compress ]", and installing bspzip++ covers any branch that still lacks it.
  // A game whose bspzip genuinely lacks -repack will fail with a non-zero exit code, which is checked.
  "CheckExitCode": true,
  "WorkingDirectory": "$binFolder$"
}