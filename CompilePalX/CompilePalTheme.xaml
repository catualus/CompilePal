<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="options">

    <!--
      Compile Pal's own semantic colours. These are deliberately chosen to stay legible against both
      the light and dark WPF-UI backdrops, so they do not need a per-theme variant.

      Everything else (window chrome, controls, text, selection) now comes from WPF-UI's theme
      dictionaries. Legacy MahApps.* resource keys are still referenced in a number of views; those are
      aliased onto the equivalent WPF-UI brushes at runtime by ThemeBridge, which re-runs on every theme
      change so the aliases follow light/dark.
    -->

    <!-- Compile Pal brand red, used for the accent and progress -->
    <Color x:Key="CompilePal.Colors.Brand">#FFE41F27</Color>

    <Color x:Key="CompilePal.Colors.Warning">#FFC700</Color>
    <Color x:Key="CompilePal.Colors.Link">#FF3B9EFF</Color>
    <Color x:Key="CompilePal.Colors.Success">#FF48B21B</Color>

    <!-- compile message severities, ascending -->
    <Color x:Key="CompilePal.Colors.Severity1">#FF7392F0</Color>
    <Color x:Key="CompilePal.Colors.Severity2">#FFEFA718</Color>
    <Color x:Key="CompilePal.Colors.Severity3">#FFEA761D</Color>
    <Color x:Key="CompilePal.Colors.Severity4">#FFE42826</Color>
    <Color x:Key="CompilePal.Colors.Severity5">#FFF21311</Color>

    <SolidColorBrush x:Key="CompilePal.Brushes.Brand" Color="{StaticResource CompilePal.Colors.Brand}" options:Freeze="True" />
    <SolidColorBrush x:Key="CompilePal.Brushes.Warning" Color="{StaticResource CompilePal.Colors.Warning}" options:Freeze="True" />
    <SolidColorBrush x:Key="CompilePal.Brushes.Link" Color="{StaticResource CompilePal.Colors.Link}" options:Freeze="True" />
    <SolidColorBrush x:Key="CompilePal.Brushes.Success" Color="{StaticResource CompilePal.Colors.Success}" options:Freeze="True" />

    <SolidColorBrush x:Key="CompilePal.Brushes.Severity1" Color="{StaticResource CompilePal.Colors.Severity1}" options:Freeze="True" />
    <SolidColorBrush x:Key="CompilePal.Brushes.Severity2" Color="{StaticResource CompilePal.Colors.Severity2}" options:Freeze="True" />
    <SolidColorBrush x:Key="CompilePal.Brushes.Severity3" Color="{StaticResource CompilePal.Colors.Severity3}" options:Freeze="True" />
    <SolidColorBrush x:Key="CompilePal.Brushes.Severity4" Color="{StaticResource CompilePal.Colors.Severity4}" options:Freeze="True" />
    <SolidColorBrush x:Key="CompilePal.Brushes.Severity5" Color="{StaticResource CompilePal.Colors.Severity5}" options:Freeze="True" />

    <!--
      Surface hierarchy. These two must stay visually distinct: the page sits behind, panels sit on top
      of it as cards. Mapping both to similar fills is what made the layout read as one flat sheet with
      no panel boundaries.
    -->
    <StaticResource x:Key="CompilePal.Brushes.GridBackground" ResourceKey="ApplicationBackgroundBrush" />
    <StaticResource x:Key="CompilePal.Brushes.DockBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
    <StaticResource x:Key="CompilePal.Brushes.CardStroke" ResourceKey="CardStrokeColorDefaultBrush" />
    <StaticResource x:Key="CompilePal.Brushes.CheckboxDisabled" ResourceKey="ControlFillColorDisabledBrush" />

    <!-- Compact list rows: Fluent's default ListBoxItem padding is far too tall for the dense
         preset/process lists, which left them sprawling down the window. -->
    <Style x:Key="CompilePal.Styles.CompactListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- DataGridTextColumn cells (parameter/process Description, Warning) default to single-line text
         that clips instead of growing the row, which truncated anything longer than the column's
         starting width. Columns using this should also use star sizing so they can grow with the
         window instead of relying on wrapping alone. -->
    <Style x:Key="CompilePal.Styles.WrappingCellText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CompilePal.Styles.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Thin, rounded, arrow-less scrollbar - the default is a thick flat Win32 track with square
         paging buttons at both ends, visible on almost every list/grid in the app. -->
    <Style x:Key="CompilePal.Styles.ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder" Background="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompilePal.Styles.ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="CompilePal.Templates.ScrollBarVertical" TargetType="{x:Type ScrollBar}">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="6" HorizontalAlignment="Center">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource CompilePal.Styles.ScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource CompilePal.Styles.ScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource CompilePal.Styles.ScrollBarThumb}" Width="6" MinHeight="24" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="CompilePal.Templates.ScrollBarHorizontal" TargetType="{x:Type ScrollBar}">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Height="6" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource CompilePal.Styles.ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource CompilePal.Styles.ScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource CompilePal.Styles.ScrollBarThumb}" Height="6" MinWidth="24" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template" Value="{StaticResource CompilePal.Templates.ScrollBarHorizontal}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource CompilePal.Templates.ScrollBarVertical}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small icon-only "..." action button used in list rows (preset/game kebab menus). It needs a
         fully custom template just to get square-with-rounded-corners hit bounds instead of a pill, so
         hover/press/disabled are set here directly - using the same WPF-UI brushes ThemeBridge aliases
         the old MahApps hover/press keys to elsewhere, rather than the MahApps-era GrayBrush7/8 keys
         this replaced, which no longer resolve to anything now that MahApps is gone. -->
    <Style x:Key="CompilePal.Styles.KebabButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Grid>
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <ContentPresenter
                            x:Name="PART_ContentPresenter"
                            Margin="{TemplateBinding BorderThickness}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fluent-style tab strip: flat header text with an accent underline on the active tab. Applied to
         every TabControl/TabItem implicitly (no x:Key) since the WPF default template - a raised, boxed
         Win32 tab - is the single most visible "Windows 8" leftover in the app. -->
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <ContentPresenter x:Name="ContentSite" Grid.Row="0" ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Indicator" Grid.Row="1" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" Opacity="0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Strips the default TabControl chrome (a raised gray box around the whole strip) down to the
         header row plus a hairline divider, so tab items sit flush with the surrounding panel like the
         rest of the app instead of looking boxed-in. -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Background="Transparent" HorizontalAlignment="Left" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim rounded "pill" progress bar. The default template is a thick flat bar with a hard square
         end and no accent color, which reads as dated against the rest of the Fluent surface. -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3">
                        <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left" Fill="{TemplateBinding Foreground}" RadiusX="3" RadiusY="3" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
