<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWPF>True</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>True</SelfContained>
    <DebugType>embedded</DebugType>
    <PlatformName>windows</PlatformName>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>CompilePalIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="CompilePalIcon.ico" />
    <None Include="Presets/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Parameters/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Plugins/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Keys/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Compiling/errorstyle.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Compiling/errorpage.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Compiling/errors.default.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Compiling/errors.default.txt')" />
    <None Include="Compiling/errors.supplement.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="version.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="version_prerelease.txt" CopyToOutputDirectory="PreserveNewest" />
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <!--
    The telemetry endpoint is injected at build time, not written in the source.

    Two reasons, and neither is "this hides it from an attacker" - the binary has to contain
    the URL to reach it, and one packet capture reveals it. What this does buy:

      - The public repository contains no endpoint. It is not in GitHub search, not in a
        grep of the source, and a fork does not silently inherit somewhere to report to.
      - Builds that are not ours report nowhere. The default below is empty, and
        TelemetryManager treats an empty endpoint as "reporting unavailable", so a local
        build or a fork sends nothing no matter what the user toggles.

    Official builds pass -p:TelemetryEndpoint=... from a repository secret; see the release
    workflow. Set it locally only if you are pointing a dev build at your own collector.
  -->
  <PropertyGroup>
    <!--
      Debug builds get a deliberately unroutable endpoint so developers and the test suite
      exercise the real code path without a secret and without touching production.
      `.invalid` is reserved by RFC 2606 and can never resolve, so a send attempt fails in
      DNS and is dropped - which is exactly what TelemetryManager does with any failure.
    -->
    <TelemetryEndpoint Condition="'$(TelemetryEndpoint)' == '' And '$(Configuration)' == 'Debug'">https://telemetry.invalid/api/telemetry/v1/events</TelemetryEndpoint>
    <!-- Release builds report nowhere unless the endpoint is injected. A fork or an
         unofficial build therefore sends nothing, whatever the user toggles. -->
    <TelemetryEndpoint Condition="'$(TelemetryEndpoint)' == ''"></TelemetryEndpoint>

    <!--
      Release signing. Each official build signs its submission so the service can tell our
      traffic from scripted noise, and can drop a leaked release's key without shipping a new
      client to everyone.

      The key is per-release, derived by the release workflow as
      HMAC(root, "compilepal/v1/" + version). The server derives the same value from the version
      in the signed body, so shipping a new release needs no server-side change at all - the
      earlier design listed one key per release in the service's environment, which put a manual
      step on the release path.

      This is NOT authentication and must not be described as such: the client is handed to the
      public, so the key inside it is a published key to anyone who looks. That is the same
      reason the write endpoint has no bearer token. Unsigned builds keep working indefinitely -
      the service never rejects a submission for being unsigned, it records it as unsigned.
    -->
    <TelemetrySigningKeyGeneration Condition="'$(TelemetrySigningKeyGeneration)' == ''"></TelemetrySigningKeyGeneration>
    <TelemetrySigningKey Condition="'$(TelemetrySigningKey)' == ''"></TelemetrySigningKey>
  </PropertyGroup>

  <Target Name="GenerateTelemetryEndpoint" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <TelemetryEndpointFile>$(IntermediateOutputPath)TelemetryEndpoint.g.cs</TelemetryEndpointFile>
    </PropertyGroup>
    <!-- WriteOnlyWhenDifferent keeps this from dirtying the build on every compile. -->
    <WriteLinesToFile
        File="$(TelemetryEndpointFile)"
        Lines="// Generated by the GenerateTelemetryEndpoint target. Do not edit, do not commit.;namespace CompilePalX { internal static partial class TelemetryEndpoints { internal const string Default = &quot;$(TelemetryEndpoint)&quot;%3B internal const string SigningKeyGeneration = &quot;$(TelemetrySigningKeyGeneration)&quot;%3B internal const string SigningKey = &quot;$(TelemetrySigningKey)&quot;%3B } }"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(TelemetryEndpointFile)" />
      <FileWrites Include="$(TelemetryEndpointFile)" />
    </ItemGroup>
  </Target>
  <!-- Most types worth testing are public already, but a few cannot be: anything whose signature
       mentions CompileProcess is internal because CompileProcess is. Widening those to public purely
       so a test can reach them would be shaping the API around the tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CompilePalX.Tests" />
  </ItemGroup>
  <!-- Meshwright, the offline nav mesh generator that used to be compiled in here, is now installed
       as an ordinary Compile Pal plugin instead: a folder under Plugins/ containing meta.json,
       parameters.json and a self-contained meshwright.exe, which ConfigurationManager discovers on
       its own. See https://github.com/catualus/MeshWright.

       Linking it was the wrong shape for something optional. It made a separate repository a hard
       build dependency of this one - a clone without it did not compile at all, with an error about a
       submodule rather than anything to do with the feature - and there was no way for a user to
       decide whether they wanted the step. As a plugin, having it is a folder and not having it is no
       folder, and it works against upstream Compile Pal rather than only this fork. -->
  <ItemGroup>
    <PackageReference Include="Glob" Version="1.1.9" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
    <PackageReference Include="ValveKeyValue" Version="0.20.0.417" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Plugins\" />
  </ItemGroup>
  <!--<Target AfterTargets="AfterBuild;NonWinFodyTarget" Name="CleanReferenceCopyLocalPaths">
    <Delete Files="@(ReferenceCopyLocalPaths->'$(OutDir)%(DestinationSubDirectory)%(Filename).dll')" />
    <Delete Files="@(ReferenceCopyLocalPaths->'$(OutDir)%(DestinationSubDirectory)%(Filename).pdb')" />
    <Delete Files="@(ReferenceCopyLocalPaths->'$(OutDir)%(DestinationSubDirectory)%(Filename).xml')" />
    <Delete Files="@(ReferenceCopyLocalPaths->'$(OutDir)%(DestinationSubDirectory)%(Filename).config')" />
  </Target>-->
  <Target Name="CleanOutputDirectory" AfterTargets="Clean">
    <RemoveDir Directories="$(OUTDIR)" />
  </Target>
</Project>