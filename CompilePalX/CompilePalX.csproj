<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWPF>True</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>True</SelfContained>
    <DebugType>embedded</DebugType>
    <PlatformName>windows</PlatformName>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>CompilePalIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="CompilePalIcon.ico" />
    <None Include="Presets/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Parameters/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Plugins/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Keys/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Compiling/errorstyle.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Compiling/errors.default.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Compiling/errors.default.txt')" />
    <None Include="Compiling/errors.supplement.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="version.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="version_prerelease.txt" CopyToOutputDirectory="PreserveNewest" />
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>
  <!-- NavPal lives in its own repository now, so its project file is no longer at a fixed path
       relative to this one. It is looked for in the two places it actually turns up: a submodule
       under external/, which is what a fresh clone of this repo gets, and a sibling checkout beside
       this repo, which is the usual arrangement when both are being worked on at once.

       Still linked rather than shelled out to. Compile Pal publishes self-contained and single-file,
       so a sibling navpal.exe would need its own runtime files carried alongside it. -->
  <PropertyGroup>
    <NavPalProject Condition="Exists('$(MSBuildThisFileDirectory)..\external\NavPal\NavPal\NavPal.csproj')">$(MSBuildThisFileDirectory)..\external\NavPal\NavPal\NavPal.csproj</NavPalProject>
    <NavPalProject Condition="'$(NavPalProject)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\NavPal\NavPal\NavPal.csproj')">$(MSBuildThisFileDirectory)..\..\NavPal\NavPal\NavPal.csproj</NavPalProject>
  </PropertyGroup>

  <!-- Without this the failure is an unresolved `using NavPal;` in NavPalProcess.cs and a wall of
       type errors, which says nothing about the real cause. -->
  <Target Name="EnsureNavPalPresent" BeforeTargets="ResolveProjectReferences" Condition="'$(NavPalProject)' == ''">
    <Error Text="NavPal could not be found. It is a separate repository as of the split, and is expected either at external/NavPal (run: git submodule update --init --recursive) or checked out beside this repository." />
  </Target>

  <ItemGroup Condition="'$(NavPalProject)' != ''">
    <ProjectReference Include="$(NavPalProject)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Analytics" Version="3.8.1" />
    <PackageReference Include="Glob" Version="1.1.9" />
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
    <PackageReference Include="ValveKeyValue" Version="0.20.0.417" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Plugins\" />
  </ItemGroup>
  <!--<Target AfterTargets="AfterBuild;NonWinFodyTarget" Name="CleanReferenceCopyLocalPaths">
    <Delete Files="@(ReferenceCopyLocalPaths->'$(OutDir)%(DestinationSubDirectory)%(Filename).dll')" />
    <Delete Files="@(ReferenceCopyLocalPaths->'$(OutDir)%(DestinationSubDirectory)%(Filename).pdb')" />
    <Delete Files="@(ReferenceCopyLocalPaths->'$(OutDir)%(DestinationSubDirectory)%(Filename).xml')" />
    <Delete Files="@(ReferenceCopyLocalPaths->'$(OutDir)%(DestinationSubDirectory)%(Filename).config')" />
  </Target>-->
  <Target Name="CleanOutputDirectory" AfterTargets="Clean">
    <RemoveDir Directories="$(OUTDIR)" />
  </Target>
</Project>